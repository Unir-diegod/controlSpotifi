# =============================================================================
# VARIABLES DE ENTORNO - FAMILY FLOW (PRODUCCIÓN / DESARROLLO)
# Copia este archivo como .env y completa los valores con tus credenciales reales.
# =============================================================================

# --- SEGURIDAD PRINCIPAL (OBLIGATORIAS EN PRODUCCIÓN) ---
DJANGO_SECRET_KEY=genera-aqui-una-clave-secreta-larga-y-aleatoria-de-50-caracteres
DJANGO_DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com,tu-app.up.railway.app,tu-app.onrender.com

# --- BASE DE DATOS POSTGRESQL (OPCIÓN 1: URL COMPLETA - RECOMENDADA) ---
# Usada por Railway, Render, Supabase, Neon, AWS RDS, Heroku, etc.
DATABASE_URL=postgresql://usuario_postgres:password_seguro@host_postgres:5432/nombre_base_datos

# --- BASE DE DATOS POSTGRESQL (OPCIÓN 2: VARIABLES INDIVIDUALES) ---
# Si no usas DATABASE_URL, descomenta y define estas variables:
# DB_NAME=familyflow_db
# DB_USER=familyflow_user
# DB_PASSWORD=tu_password_secreto
# DB_HOST=localhost
# DB_PORT=5432

# --- SEGURIDAD HTTPS / CSRF (PRODUCCIÓN) ---
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com,https://tu-app.up.railway.app
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- PARÁMETROS GENERALES ---
TIME_ZONE=America/Bogota
LANGUAGE_CODE=es

